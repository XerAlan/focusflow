{
  "name": "focusflow",
  "version": "1.0.0",
  "description": "FocusFlow - 一款帮助用户进入工作模式的 Windows 桌面专注应用",
  "main": "dist/main/main.js",
  "author": "FocusFlow Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --win --x64",
    "lint": "echo \"(可选) 在此接入 ESLint\""
  },
  "dependencies": {
    "array-move": "^4.0.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "electron-store": "^8.2.0",
    "howler": "^2.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-sort": "^1.6.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.4",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.focusflow.app",
    "productName": "FocusFlow",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusFlow"
    }
  }
}
